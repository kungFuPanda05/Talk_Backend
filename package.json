{
  "scripts": {
    "dev": "nodemon src/index.js --exec babel-node --presets @babel/env",
    "start": "node dist/src/index.js",
    "login-all-users": "nodemon script/loginAllUsers.js --exec babel-node --presets @babel/env",
    "build": "babel src --out-dir dist/src --copy-files --config-file ./src/.babelrc && babel models --out-dir dist/models --copy-files --config-file ./src/.babelrc && babel config --out-dir dist/config --copy-files --config-file ./src/.babelrc",
    "start:prod": "node dist/src/index.js",
    "db:bootstrap": "node scripts/bootstrap-production.js",
    "smoke:guest-coins": "babel-node scripts/smoke-guest-coins.js --presets @babel/env"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "ignore": [
      "trie-backup.json",
      "dist/**"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.24.0",
    "@babel/node": "^7.23.9",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "nodemon": "^3.1.0",
    "puppeteer": "^24.22.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.41.7",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "email-validator": "^2.0.4",
    "express": "^4.18.3",
    "express-sanitizer": "^1.0.6",
    "heap-js": "^2.6.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.9.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.1",
    "stack-trace": "^1.0.0-pre2",
    "uuid": "^11.0.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "core-js@3.36.0": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "puppeteer@24.43.1": true
  }
}
